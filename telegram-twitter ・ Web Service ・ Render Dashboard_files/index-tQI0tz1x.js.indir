  query serverCacheEvents($id: String!) {
    serviceEvents(
      serviceId: $id
      include: ["DeployStarted", "EdgeCachePurged", "EdgeCacheEnabled"]
      limit: 1
    ) {
      events {
        id
        timestamp
        ... on EdgeCachePurged {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on EdgeCacheEnabled {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on DeployStarted {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
      }
    }
  }
