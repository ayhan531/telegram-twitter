  query artifactSourcePreview($id: String!) {
    artifactSource(id: $id) {
      id
      name
      buildConfig {
        repoNode {
          sourceBranch
          repo {
            provider
            name
            ownerName
            webURL
          }
        }
      }
      externalImage {
        imageHost
        imageRepository
        imageName
        imageRef
      }
      latestArtifact {
        id
        build {
          id
          status
        }
      }
    }
  }
