  fragment deployWithTriggerFields on Deploy {
    id
    buildId
    artifactSourceId
    server {
      id
      userFacingTypeSlug
    }
    buildFinishedAt
    createdAt
    updatedAt
    startedAt
    finishedAt
    finishedAtUnixNano
    initialDeployHookFinishedAtUnixNano
    status
    rollbackSupportStatus
    commitId
    commitShortId
    commitMessage
    commitURL
    commitCreatedAt
    imageSHA
    externalImage {
      imageHost
      imageName
      imageRef
      imageRepository
    }
    reason {
      ...failureReasonFields
    }
    triggerDetails {
      type
      clearCache
      clusterSynced
      firstBuild
      newCommit
      rollbackTargetDeployID
      updatedProperty
      userAgent
      isTransitionToFreeTier
      transferredFrom
      iacExecution {
        id
        source {
          id
        }
      }
      user {
        id
        email
        avatarDownload {
          url
        }
      }
    }
  }
  ${Ps}
`,vV=new Ei(W`
  query deployWithTrigger($id: String!) {
    deploy(id: $id) {
      ...deployWithTriggerFields
    }
  }
  ${_V}
`),yV=new Ei(W`
  query deploysWithTrigger($input: DeployFilterInput!) {
    deploys(input: $input) {
      ...deployWithTriggerFields
    }
  }
  ${_V}
`),bV=new fa(W`
  subscription deployWithTriggerCreated($serverId: String!) {
    deployCreated(serverId: $serverId) {
      ...deployWithTriggerFields
    }
  }
  ${_V}
`),xV=new fa(W`
  subscription deployWithTriggerUpdated($deployId: String!) {
    deployUpdated(deployId: $deployId) {
      ...deployWithTriggerFields
    }
  }
  ${_V}
